{
  "redirects": [
    {
      "source": "/contatti.html",
      "destination": "/#contatti",
      "permanent": true
    },
    {
      "source": "/staff.html",
      "destination": "/istruttori.html",
      "permanent": true
    },
    {
      "source": "/corsi/:id/:slug(.*kick.*bambin.*|.*bambin.*|.*kids.*|.*ragazz.*)",
      "destination": "/corsi/kickboxing-ragazzi.html",
      "permanent": true
    },
    {
      "source": "/corsi/:id/:slug(.*kick.*|.*k-1.*|.*k1.*)",
      "destination": "/corsi/kickboxing.html",
      "permanent": true
    },
    {
      "source": "/corsi/:id/:slug(.*pugilat.*|.*boxe.*|.*boxing.*)",
      "destination": "/corsi/pugilato.html",
      "permanent": true
    },
    {
      "source": "/corsi/:id/:slug(.*difesa.*|.*path.*)",
      "destination": "/corsi/autodifesa-path.html",
      "permanent": true
    },
    {
      "source": "/corsi/:id/:slug(.*function.*|.*funzional.*|.*pump.*)",
      "destination": "/corsi/functional-training.html",
      "permanent": true
    },
    {
      "source": "/corsi/:id/:slug(.*calisth.*)",
      "destination": "/corsi/calisthenics.html",
      "permanent": true
    },
    {
      "source": "/corsi/:id/:slug(.*postur.*)",
      "destination": "/corsi/ginnastica-posturale.html",
      "permanent": true
    },
    {
      "source": "/corsi/:id/:slug(.*senior.*)",
      "destination": "/corsi/active-senior.html",
      "permanent": true
    },
    {
      "source": "/corsi/:id/:slug(.*pesi.*|.*sala.*)",
      "destination": "/corsi/sala-pesi.html",
      "permanent": true
    },
    {
      "source": "/corsi/:id/:slug+",
      "destination": "/#corsi",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\", </llms.txt>; rel=\"describedby\"; type=\"text/plain\", </md/index.md>; rel=\"alternate\"; type=\"text/markdown\""
        },
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/(.+)\\.html",
      "headers": [
        {
          "key": "Link",
          "value": "</sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\", </llms.txt>; rel=\"describedby\"; type=\"text/plain\""
        },
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/.well-known/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/.well-known/api-catalog",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/linkset+json; profile=\"https://www.rfc-editor.org/info/rfc9727\""
        }
      ]
    },
    {
      "source": "/.well-known/ai-catalog.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/.well-known/agent-skills/index.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/.well-known/agent-skills/(.*)/SKILL.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/md/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/okf/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/ads/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, noimageindex"
        }
      ]
    },
    {
      "source": "/LEGGIMI.txt",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
